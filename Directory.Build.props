<Project>
  <!-- Shared settings for every C# project. Native projects use build/native.props instead. -->
  <PropertyGroup Condition="'$(MSBuildProjectExtension)' == '.csproj'">
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
    <Version>1.1.0</Version>
    <Authors>FluentSetup contributors</Authors>
    <Product>FluentSetup</Product>
    <Copyright>Copyright (c) 2026 FluentSetup contributors</Copyright>
    <!-- CA1031 (catch general exceptions) and CA1303 (localized literals) do not fit a CLI that reports every error. -->
    <NoWarn>$(NoWarn);CA1031;CA1303;CA1848;CA2007;CA1305;CA1307;CA1309;CA1310;CA1311;CA1304;CA1062;CA1716;CA1819;CA1002;CA2227;CA1056;CA1054;CA1055;CA1515;CA1822;CA1859;CA1861;CA1863;CA1865;CA1866;CA1867;CA1869;CA1872;CA5394;CA1024;CA1031;CA1708;CA1720;CA1724;CA1805;CA1001;CA1063;CA1816;CA2000;CA2213;CA1849;CA1835;CA1513;CA1512;CA1510;CA1508;CA1823</NoWarn>
  </PropertyGroup>
</Project>
