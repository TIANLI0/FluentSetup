{
  "$schema": "../../shared/schemas/fluentsetup.project.schema.json",
  "schemaVersion": 1,
  "app": {
    "id": "EncoDeck",
    "name": "EncoDeck",
    "publisher": "Tianli",
    "version": "1.15.0",
    "description": "EncoDeck",
    "website": "https://github.com/TIANLI0/EncoDeck",
    "icon": "D:/develop/EncoDeck/src/EncoDeck.App/Assets/EncoDeck.ico",
    "mainExecutable": "EncoDeck.exe"
  },
  "files": {
    "include": ["**/*"],
    "exclude": ["**/*.pdb"],
    "preserve": [],
    "extra": [
      { "source": "D:/develop/EncoDeck/README.md", "target": "" },
      { "source": "D:/develop/EncoDeck/README_EN.md", "target": "" }
    ],
    "emptyDirectories": [],
    "variants": [
      {
        "id": "selfContained",
        "label": { "en-US": "Self-contained (includes runtimes)" },
        "default": true,
        "source": "../../out/encodeck/selfContained"
      },
      {
        "id": "shared",
        "label": { "en-US": "Shared runtimes (smaller)" },
        "source": "../../out/encodeck/shared"
      }
    ]
  },
  "install": {
    "scope": "userOrMachine",
    "defaultScope": "user",
    "userDir": "{LocalAppData}\\Programs\\{AppName}",
    "machineDir": "{ProgramFiles}\\{AppName}",
    "allowCustomDir": true,
    "desktopShortcut": "optionalOff",
    "startMenuShortcut": "on",
    "launchAfterInstall": "optionalOn",
    "allowDowngrade": false,
    "minWindowsBuild": 19041,
    "closeCommand": { "run": "EncoDeck.exe", "arguments": ["--exit"] },
    "closeProcesses": ["EncoDeck.exe"],
    "legacyUninstallKeys": ["{48E531A0-79E2-4001-9F04-1F43A8C52FE9}_is1"]
  },
  "requirements": {
    "dotNet": [
      {
        "runtime": "core",
        "version": "10.0.0",
        "variants": ["shared"],
        "download": {
          "url": "https://builds.dotnet.microsoft.com/dotnet/Runtime/10.0.15/dotnet-runtime-10.0.15-win-x64.exe",
          "sha256": "59b0da003d18b76e8dcc0dc05bf7e54a0e6e83e7c569d57e1ee5c270664bb128",
          "size": 30661872
        },
        "arguments": ["/install", "/quiet", "/norestart"],
        "onFailure": "fail",
        "helpUrl": "https://dotnet.microsoft.com/download/dotnet/10.0"
      }
    ],
    "windowsAppRuntime": {
      "required": true,
      "version": "2.5.1",
      "variants": ["shared"],
      "download": {
        "url": "https://download.microsoft.com/download/de664922-b046-432f-bb2a-54aec3c5f1f6/WindowsAppRuntimeInstall-x64.exe",
        "sha256": "931a421e8dc3e6e67724806cb67fecdbb88dfe323f0170842eb4a4b4b149f1e2",
        "size": 120199480
      },
      "arguments": ["--quiet"],
      "onFailure": "fail",
      "helpUrl": "https://learn.microsoft.com/windows/apps/windows-app-sdk/downloads"
    }
  },
  "options": [
    {
      "id": "autostart",
      "label": { "en-US": "Start EncoDeck in the background when Windows starts" },
      "default": false,
      "startup": { "name": "EncoDeck", "arguments": ["--background"] }
    }
  ],
  "uninstall": {
    "removeRunValues": ["EncoDeck"]
  },
  "ui": {
    "theme": "system",
    "backdrop": "mica",
    "useSystemAccent": true,
    "license": "D:/develop/EncoDeck/LICENSE",
    "licenseMode": "firstInstall",
    "localization": "locales",
    "defaultLanguage": "auto",
    "strings": {}
  },
  "output": {
    "directory": "../../out/encodeck/dist",
    "fileName": "EncoDeck-Setup-{Version}-{Architecture}.exe",
    "architecture": "x64",
    "variants": [],
    "compression": "max",
    "includeWinUI": true
  },
  "signing": { "enabled": false }
}
