{
  "$schema": "../../shared/schemas/fluentsetup.project.schema.json",
  "schemaVersion": 1,
  "app": {
    "id": "THRM",
    "name": "THRM",
    "publisher": "TIANLI0",
    "version": "3.8.0",
    "description": "THRM 桌面控制中心",
    "website": "https://github.com/TIANLI0/THRM",
    "icon": "D:/develop/BS2PRO-Controller/build/windows/icon.ico",
    "mainExecutable": "THRM.exe"
  },
  "files": {
    "source": "D:/develop/BS2PRO-Controller/build/bin",
    "include": ["./THRM.exe", "./THRM Core.exe", "bridge/**"],
    "exclude": ["**/*.pdb", "**/*.xml"],
    "preserve": [],
    "extra": [
      { "source": "D:/develop/BS2PRO-Controller/build/bin/PawnIO_setup.exe", "target": "drivers/PawnIO" },
      { "source": "D:/develop/BS2PRO-Controller/build/windows/installer/MicrosoftEdgeWebview2Setup.exe", "target": "redist" }
    ],
    "emptyDirectories": []
  },
  "install": {
    "scope": "machine",
    "defaultScope": "machine",
    "userDir": "{LocalAppData}\\Programs\\{AppName}",
    "machineDir": "{ProgramFiles}\\{AppName}",
    "allowCustomDir": true,
    "desktopShortcut": "optionalOn",
    "startMenuShortcut": "on",
    "launchAfterInstall": "optionalOn",
    "allowDowngrade": false,
    "minWindowsBuild": 17763,
    "closeProcesses": [
      "THRM.exe", "THRM Core.exe", "THRM TempBridge.exe", "TempBridge.exe", "SpaceStationService.exe",
      "BS2PRO-Controller.exe", "BS2PRO.exe", "BS2PRO-Core.exe"
    ],
    "adoptExistingInstall": true,
    "legacyUninstallKeys": [
      "BS2PRO-Controller", "BS2PRO-controllerBS2PRO-controller", "BS2PRO-ControllerBS2PRO-Controller",
      "TIANLI0BS2PRO-Controller", "TIANLI0BS2PRO"
    ],
    "ngen": ["bridge/THRM TempBridge.exe"],
    "cleanup": {
      "removeScheduledTasks": ["THRM", "BS2PRO-Controller", "BS2PRO-Core"],
      "removeRunValues": ["BS2PRO-Controller", "BS2PRO-Core"],
      "removeShortcuts": [
        "BS2PRO-Controller.lnk", "BS2PRO.lnk", "BS2Pro Controller.lnk", "BS2PRO Core.lnk", "BS2PRO-Core.lnk"
      ],
      "removeUninstallKeys": []
    }
  },
  "requirements": {
    "netFramework": "4.7.2",
    "netFrameworkSetup": {
      "helpUrl": "https://dotnet.microsoft.com/download/dotnet-framework/net472"
    },
    "webView2": {
      "required": true,
      "minVersion": "120.0.0.0",
      "installer": "redist/MicrosoftEdgeWebview2Setup.exe",
      "arguments": ["/silent", "/install"],
      "onFailure": "fail",
      "helpUrl": "https://developer.microsoft.com/microsoft-edge/webview2/"
    }
  },
  "options": [
    { "id": "pawnio", "label": { "en-US": "Install PawnIO (required)" }, "required": true },
    { "id": "autostart", "label": { "en-US": "Start with Windows" }, "default": true }
  ],
  "actions": [
    {
      "id": "pawnio",
      "when": "afterInstall",
      "run": "drivers/PawnIO/PawnIO_setup.exe",
      "arguments": ["-install", "-silent"],
      "timeoutSeconds": 60,
      "successExitCodes": [0, 183],
      "onFailure": "warn",
      "ifOption": "pawnio",
      "skipIfInstalled": {
        "hive": "HKLM",
        "key": "SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Uninstall\\PawnIO",
        "value": "DisplayVersion",
        "version": "2.2.0.0"
      },
      "fallbackArguments": ["-install"],
      "name": { "en-US": "PawnIO driver installation" }
    },
    {
      "id": "autostart",
      "when": "afterInstall",
      "run": "THRM Core.exe",
      "arguments": ["--install-autostart"],
      "timeoutSeconds": 60,
      "successExitCodes": [0],
      "onFailure": "warn",
      "ifOption": "autostart",
      "fallbackRunValue": { "name": "THRM", "arguments": ["--autostart"] },
      "name": { "en-US": "Registering THRM to start with Windows" }
    }
  ],
  "uninstall": {
    "removeData": ["{AppData}\\THRM.exe", "{AppData}\\THRM", "{LocalAppData}\\THRM", "{CommonAppData}\\THRM.exe", "{CommonAppData}\\THRM"],
    "removeScheduledTasks": ["THRM", "BS2PRO-Controller", "BS2PRO-Core"],
    "removeRunValues": ["THRM", "BS2PRO-Controller", "BS2PRO-Core"],
    "removeShortcuts": [
      "THRM.lnk", "BS2PRO-Core.lnk", "BS2PRO-Controller.lnk", "BS2PRO.lnk", "BS2Pro Controller.lnk", "BS2PRO Core.lnk"
    ]
  },
  "ui": {
    "theme": "system",
    "backdrop": "mica",
    "useSystemAccent": true,
    "license": "D:/develop/BS2PRO-Controller/build/windows/installer/resources/license_en-US.txt",
    "licenseMode": "always",
    "localization": "locales",
    "defaultLanguage": "auto",
    "strings": {}
  },
  "output": {
    "directory": "../../out/thrm",
    "fileName": "THRM-{Version}-Setup.exe",
    "architecture": "x64",
    "compression": "max",
    "includeWinUI": true
  },
  "signing": { "enabled": false }
}
