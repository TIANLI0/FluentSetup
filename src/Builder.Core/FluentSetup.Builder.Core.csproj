<Project Sdk="Microsoft.NET.Sdk">
  <!-- Configuration model, validation and package building shared by FluentSetup.CLI and the WinUI Builder. -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <RootNamespace>FluentSetup.Builder.Core</RootNamespace>
    <AssemblyName>FluentSetup.Builder.Core</AssemblyName>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>
  <ItemGroup>
    <!-- MIT licensed managed port of Zstandard (compression side only is used here). -->
    <PackageReference Include="ZstdSharp.Port" Version="0.8.8" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="FluentSetup.Builder.Core.Tests" />
  </ItemGroup>
</Project>
