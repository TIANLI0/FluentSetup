<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>fsetup</AssemblyName>
    <RootNamespace>FluentSetup.Cli</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- Native installer runtime built by FluentSetup.sln (native projects). -->
    <FsNativeOut>$(MSBuildThisFileDirectory)..\..\out\bin\</FsNativeOut>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Builder.Core\FluentSetup.Builder.Core.csproj" />
    <!-- Argument parser tests. -->
    <InternalsVisibleTo Include="FluentSetup.Builder.Core.Tests" />
  </ItemGroup>
  <!-- Runtime assets that get embedded into every Setup.exe. -->
  <ItemGroup>
    <None Include="$(FsNativeOut)x64\Release\FluentSetup.Stub.exe" Link="runtime\x64\FluentSetup.Stub.exe" CopyToOutputDirectory="PreserveNewest" Condition="Exists('$(FsNativeOut)x64\Release\FluentSetup.Stub.exe')" />
    <None Include="$(FsNativeOut)x64\Release\ui\*.exe;$(FsNativeOut)x64\Release\ui\*.dll;$(FsNativeOut)x64\Release\ui\*.pri;$(FsNativeOut)x64\Release\ui\*.xbf" LinkBase="runtime\x64\ui" CopyToOutputDirectory="PreserveNewest" />
    <None Include="$(FsNativeOut)ARM64\Release\FluentSetup.Stub.exe" Link="runtime\arm64\FluentSetup.Stub.exe" CopyToOutputDirectory="PreserveNewest" Condition="Exists('$(FsNativeOut)ARM64\Release\FluentSetup.Stub.exe')" />
    <None Include="$(FsNativeOut)ARM64\Release\ui\*.exe;$(FsNativeOut)ARM64\Release\ui\*.dll;$(FsNativeOut)ARM64\Release\ui\*.pri;$(FsNativeOut)ARM64\Release\ui\*.xbf" LinkBase="runtime\arm64\ui" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\shared\localization\*.json" LinkBase="runtime\localization" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\shared\schemas\*.json" LinkBase="schemas" CopyToOutputDirectory="PreserveNewest" />
    <!-- fsetup guide / schema: always the documentation of this exact build. -->
    <EmbeddedResource Include="..\..\docs\ai-guide.md" LogicalName="FluentSetup.Cli.ai-guide.md" />
    <EmbeddedResource Include="..\..\shared\schemas\fluentsetup.project.schema.json" LogicalName="FluentSetup.Cli.fluentsetup.project.schema.json" />
    <None Include="..\..\assets\default-app.ico" Link="runtime\default-app.ico" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- NuGet package FluentSetup.Cli: a .NET tool ("dotnet tool install -g FluentSetup.Cli" gives the fsetup
       command). The runtime\ folder above is part of the tool's files, so it builds installers on its own.
       PackAsTool needs a TargetFramework without a platform (net10.0, NETSDK1146); scripts/pack-nuget.ps1 checks that.
       RollForward lets the tool and the copy in FluentSetup.MSBuild run on a newer .NET when 10 is not installed. -->
  <PropertyGroup>
    <PackageId>FluentSetup.Cli</PackageId>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>fsetup</ToolCommandName>
    <RollForward>Major</RollForward>
    <Description>fsetup: the command-line tool of FluentSetup. Builds native Windows 11-style installers (a single Setup.exe) from a fluentsetup.json, validates projects, inspects packages and writes winget manifests. Includes the installer runtime.</Description>
    <PackageTags>installer;setup;setup.exe;windows;winui;winget;cli;dotnet-tool;fsetup;fluentsetup</PackageTags>
  </PropertyGroup>
  <Import Project="..\..\build\nuget.props" />

  <!-- "fluentsetup", the command's original name, keeps working: a copy of the apphost (about 150 KB, it runs
       fsetup.dll) next to fsetup.exe in framework-dependent Windows publishes, such as the cli folder of FluentSetup's
       own installer. Single-file publishes skip it (a copy would double the download); the .tar.gz archives carry a
       symbolic link and the GitHub Action makes the alias itself. -->
  <Target Name="FsPublishAlias" AfterTargets="Publish" Condition="'$(PublishSingleFile)' != 'true' and Exists('$(PublishDir)fsetup.exe')">
    <Copy SourceFiles="$(PublishDir)fsetup.exe" DestinationFiles="$(PublishDir)fluentsetup.exe" SkipUnchangedFiles="true" />
  </Target>
</Project>
