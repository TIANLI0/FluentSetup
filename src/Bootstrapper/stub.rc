// Resources of FluentSetup.Stub.exe. FluentSetup.CLI replaces the icon group (IDI_APP) and the version resource with
// the product's own before appending the package data.
#include <winres.h>
#include "resource.h"

LANGUAGE LANG_NEUTRAL, SUBLANG_NEUTRAL

IDI_APP ICON "..\\..\\assets\\default-app.ico"

#include "localization.rc2"

CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "stub.manifest"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,0,0,0
 PRODUCTVERSION 1,0,0,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "000004b0"
        BEGIN
            VALUE "CompanyName", "FluentSetup"
            VALUE "FileDescription", "FluentSetup installer"
            VALUE "FileVersion", "1.0.0.0"
            VALUE "InternalName", "FluentSetup.Stub"
            VALUE "OriginalFilename", "FluentSetup.Stub.exe"
            VALUE "ProductName", "FluentSetup"
            VALUE "ProductVersion", "1.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0, 1200
    END
END
