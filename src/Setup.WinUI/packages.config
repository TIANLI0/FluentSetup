<?xml version="1.0" encoding="utf-8"?>
<!--
  Only the Windows App SDK *component* packages the installer UI needs are referenced.
  The Microsoft.WindowsAppSDK meta-package is intentionally avoided: it drags in Microsoft.WindowsAppSDK.Runtime (~170 MB
  of MSIX redistributables), AI/ML/Widgets/Search, none of which is used or shipped.
  Keep these versions in sync with the Microsoft.WindowsAppSDK version in src/Builder/FluentSetup.Builder.csproj.
-->
<packages>
  <package id="Microsoft.Windows.CppWinRT" version="3.0.260818.1" targetFramework="native" />
  <package id="Microsoft.Windows.SDK.BuildTools" version="10.0.26100.4654" targetFramework="native" />
  <package id="Microsoft.Windows.SDK.BuildTools.MSIX" version="1.7.251221100" targetFramework="native" />
  <package id="Microsoft.WindowsAppSDK.Base" version="2.0.4" targetFramework="native" />
  <package id="Microsoft.WindowsAppSDK.Foundation" version="2.3.12" targetFramework="native" />
  <package id="Microsoft.WindowsAppSDK.InteractiveExperiences" version="2.1.9" targetFramework="native" />
  <package id="Microsoft.WindowsAppSDK.Runtime" version="2.5.1" targetFramework="native" />
  <package id="Microsoft.WindowsAppSDK.WinUI" version="2.3.9" targetFramework="native" />
  <package id="Microsoft.Web.WebView2" version="1.0.3719.77" targetFramework="native" />
</packages>

