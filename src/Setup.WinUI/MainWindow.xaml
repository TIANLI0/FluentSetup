<?xml version="1.0" encoding="utf-8"?>
<!--
  Installer window, laid out like the Windows App Installer / Android-app (APK) install dialog:
  one Mica surface, a question as the title, publisher/version lines, the app icon large at the top right,
  "Launch when ready" at the bottom left and progress shown inline in the bottom bar.
-->
<Window
    x:Class="FluentSetupUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid x:Name="RootGrid">
        <Grid.Resources>
            <Style x:Key="QuestionStyle" TargetType="TextBlock" BasedOn="{StaticResource TitleTextBlockStyle}">
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="MaxLines" Value="3" />
            </Style>
            <Style x:Key="PageHeadingStyle" TargetType="TextBlock" BasedOn="{StaticResource SubtitleTextBlockStyle}">
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>
            <Style x:Key="InfoLineStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyTextBlockStyle}">
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="IsTextSelectionEnabled" Value="True" />
                <Setter Property="Margin" Value="0,0,0,8" />
            </Style>
            <Style x:Key="DetailLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyTextBlockStyle}">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                <Setter Property="Margin" Value="0,0,0,8" />
            </Style>
            <Style x:Key="FieldLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
                <Setter Property="Margin" Value="0,0,0,8" />
            </Style>
            <Style x:Key="SecondaryTextStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>
            <Style x:Key="FooterButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="MinWidth" Value="{StaticResource FooterButtonMinWidth}" />
            </Style>
            <Style x:Key="FooterAccentButtonStyle" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
                <Setter Property="MinWidth" Value="{StaticResource FooterButtonMinWidth}" />
            </Style>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TitleBar x:Name="AppTitleBar" IsBackButtonVisible="False" IsPaneToggleButtonVisible="False">
            <TitleBar.IconSource>
                <ImageIconSource x:Name="TitleBarIcon" />
            </TitleBar.IconSource>
        </TitleBar>

        <ScrollViewer x:Name="PageScroller" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled">
            <Grid Padding="32,8,32,12">
                    <Grid.ChildrenTransitions>
                        <TransitionCollection>
                            <EntranceThemeTransition FromVerticalOffset="8" IsStaggeringEnabled="False" />
                        </TransitionCollection>
                    </Grid.ChildrenTransitions>

                    <!-- Summary: welcome, progress and result. Only this header reserves room for the app icon. -->
                    <StackPanel x:Name="SummaryPage" Visibility="Collapsed">
                        <!-- ui.banner: decorative, first page only, scaled to the content width. -->
                        <Image x:Name="BannerImage" Stretch="Uniform" MaxHeight="160" HorizontalAlignment="Left" Margin="0,4,0,16"
                               Visibility="Collapsed" AutomationProperties.AccessibilityView="Raw" />
                        <Grid ColumnSpacing="24">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Image x:Name="AppIcon" Grid.Column="1" Width="72" Height="72" VerticalAlignment="Top" Margin="0,4,0,0"
                                   AutomationProperties.AccessibilityView="Raw" />
                            <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <FontIcon x:Name="StatusIcon" FontSize="28" VerticalAlignment="Top" Margin="0,6,12,0" Visibility="Collapsed"
                                      AutomationProperties.AccessibilityView="Raw" />
                            <TextBlock x:Name="QuestionText" Grid.Column="1" Style="{StaticResource QuestionStyle}"
                                       AutomationProperties.HeadingLevel="Level1" />
                        </Grid>
                        <!-- Who signed this setup: "Verified publisher: X"; hidden for an unsigned or untrusted setup. -->
                        <StackPanel x:Name="SignaturePanel" Orientation="Horizontal" Spacing="6" Margin="0,4,0,0" Visibility="Collapsed">
                            <FontIcon x:Name="SignatureIcon" FontSize="14" VerticalAlignment="Center" AutomationProperties.AccessibilityView="Raw" />
                            <TextBlock x:Name="SignatureText" Style="{StaticResource BodyTextBlockStyle}" TextWrapping="Wrap" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock x:Name="DescriptionText" Style="{StaticResource BodyTextBlockStyle}" TextWrapping="Wrap" MaxLines="3"
                                   TextTrimming="CharacterEllipsis" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="0,8,0,0" />
                        <StackPanel x:Name="UserDataPanel" Margin="0,16,0,0" Visibility="Collapsed">
                            <CheckBox x:Name="RemoveDataCheck" />
                            <TextBlock x:Name="UserDataPaths" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap" Margin="28,0,0,0"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>

                        <!-- Details: aligned label / value pairs. Rows collapse when they have nothing to say. -->
                        <Grid x:Name="DetailsGrid" Margin="0,20,0,0" ColumnSpacing="24">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock x:Name="PublisherLabel" Style="{StaticResource DetailLabelStyle}" />
                            <TextBlock x:Name="PublisherLine" Grid.Column="1" Style="{StaticResource InfoLineStyle}" />
                            <TextBlock x:Name="VersionLabel" Grid.Row="1" Style="{StaticResource DetailLabelStyle}" />
                            <TextBlock x:Name="VersionLine" Grid.Row="1" Grid.Column="1" Style="{StaticResource InfoLineStyle}" />
                            <TextBlock x:Name="LocationLabelDetail" Grid.Row="2" Style="{StaticResource DetailLabelStyle}" />
                            <!-- One line: the path (middle-shortened to fit) followed by "Change", which only picks a folder. -->
                            <Grid x:Name="LocationRow" Grid.Row="2" Grid.Column="1" ColumnSpacing="8" Margin="0,0,0,8" HorizontalAlignment="Left">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="LocationLine" Style="{StaticResource BodyTextBlockStyle}" TextWrapping="NoWrap" MaxWidth="400"
                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                <HyperlinkButton x:Name="ChangeLink" Grid.Column="1" Padding="4,0" Margin="0,-3,0,-3" VerticalAlignment="Center"
                                                 Click="OnBrowseClick" />
                            </Grid>
                            <TextBlock x:Name="SizeLabel" Grid.Row="3" Style="{StaticResource DetailLabelStyle}" />
                            <TextBlock x:Name="SizeLine" Grid.Row="3" Grid.Column="1" Style="{StaticResource InfoLineStyle}" />
                        </Grid>
                            </StackPanel>
                        </Grid>

                        <!-- Options live on the main page: scope (only if the package allows both), shortcuts and the
                             package's own switches such as "Start when I sign in". -->
                        <StackPanel x:Name="InlineOptions" Margin="0,8,0,0" Spacing="2" Visibility="Collapsed">
                            <StackPanel x:Name="ScopePanel" Orientation="Horizontal" Spacing="16" Margin="0,0,0,4">
                                <TextBlock x:Name="ScopeLabel" Style="{StaticResource DetailLabelStyle}" VerticalAlignment="Center" Margin="0,6,0,0" />
                                <RadioButtons x:Name="ScopeRadios" SelectionChanged="OnScopeChanged" MaxColumns="2">
                                    <RadioButton x:Name="ScopeUserRadio" />
                                    <RadioButton x:Name="ScopeMachineRadio" />
                                </RadioButtons>
                            </StackPanel>
                            <StackPanel x:Name="VariantPanel" Margin="0,0,0,4" Visibility="Collapsed">
                                <StackPanel Orientation="Horizontal" Spacing="16">
                                    <TextBlock x:Name="VariantLabel" Style="{StaticResource DetailLabelStyle}" VerticalAlignment="Center" Margin="0,6,0,0" />
                                    <RadioButtons x:Name="VariantRadios" SelectionChanged="OnVariantChanged" MaxColumns="3" />
                                </StackPanel>
                                <TextBlock x:Name="VariantDescription" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="0,2,0,0" />
                            </StackPanel>
                            <CheckBox x:Name="DesktopCheck" />
                            <CheckBox x:Name="StartMenuCheck" />
                            <StackPanel x:Name="ChoicesPanel" />
                        </StackPanel>
                        <!-- "Change <App>": what Repair does (the button is in the bottom bar). -->
                        <TextBlock x:Name="RepairNote" Style="{StaticResource SecondaryTextStyle}" Margin="0,12,0,0" Visibility="Collapsed" />
                        <!-- "Change <App>" with an update source: a newer published version, with a button that runs the updater. -->
                        <InfoBar x:Name="UpdateInfo" Severity="Informational" IsClosable="False" IsOpen="False" Margin="0,12,0,0">
                            <InfoBar.ActionButton>
                                <Button x:Name="UpdateButton" Click="OnUpdateClick" />
                            </InfoBar.ActionButton>
                        </InfoBar>
                        <InfoBar x:Name="WelcomeInfo" IsClosable="False" IsOpen="False" Margin="0,12,0,0" />
                        <InfoBar x:Name="RunningInfo" Severity="Warning" IsClosable="False" IsOpen="False" Margin="0,12,0,0" />
                        <InfoBar x:Name="WelcomeDirError" Severity="Error" IsClosable="False" IsOpen="False" Margin="0,12,0,0" />

                        <!-- Result extras -->
                        <StackPanel x:Name="ResultExtras" Spacing="8" Margin="0,16,0,0" Visibility="Collapsed">
                            <TextBlock x:Name="ResultBody" Style="{StaticResource BodyTextBlockStyle}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                            <InfoBar x:Name="ResultWarnings" Severity="Warning" IsClosable="False" IsOpen="False" />
                            <TextBlock x:Name="ResultCode" Style="{StaticResource SecondaryTextStyle}" IsTextSelectionEnabled="True" />
                            <Expander x:Name="ResultDetails" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
                                <TextBlock x:Name="ResultDetailText" Style="{StaticResource SecondaryTextStyle}" IsTextSelectionEnabled="True" FontFamily="Consolas" />
                            </Expander>
                        </StackPanel>
                    </StackPanel>

                    <!-- Settings: the package's inputs (text, password, choice), between the first page and the license. -->
                    <StackPanel x:Name="InputsPage" Spacing="12" Visibility="Collapsed">
                        <TextBlock x:Name="InputsHeading" Style="{StaticResource PageHeadingStyle}" AutomationProperties.HeadingLevel="Level1" />
                        <TextBlock x:Name="InputsSubtitle" Style="{StaticResource BodyTextBlockStyle}" TextWrapping="Wrap" />
                        <StackPanel x:Name="InputsPanel" Spacing="16" Margin="0,4,0,0" />
                    </StackPanel>

            </Grid>
        </ScrollViewer>

        <!-- License: outside the scroller so the text can use all of the available height. -->
        <Grid x:Name="LicensePage" Grid.Row="1" Padding="32,8,32,4" RowSpacing="12" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock x:Name="LicenseHeading" Style="{StaticResource PageHeadingStyle}" AutomationProperties.HeadingLevel="Level1" />
            <TextBlock x:Name="LicenseSubtitle" Grid.Row="1" Style="{StaticResource BodyTextBlockStyle}" TextWrapping="Wrap" />
            <TextBox x:Name="LicenseText" Grid.Row="2" MinHeight="120" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True"
                     ScrollViewer.VerticalScrollBarVisibility="Auto" />
            <CheckBox x:Name="LicenseAccept" Grid.Row="3" Checked="OnLicenseChanged" Unchecked="OnLicenseChanged" />
        </Grid>

        <!-- Bottom bar: "launch when ready" or live progress on the left, actions on the right. -->
        <Grid Grid.Row="2" Padding="32,12,32,24" ColumnSpacing="24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <CheckBox x:Name="LaunchCheck" VerticalAlignment="Center" />
            <StackPanel Orientation="Horizontal" Spacing="4" Margin="-12,0,0,0" VerticalAlignment="Center">
                <HyperlinkButton x:Name="OpenFolderLink" Click="OnOpenFolderClick" Visibility="Collapsed" />
                <HyperlinkButton x:Name="ViewLogLink" Click="OnViewLogClick" Visibility="Collapsed" />
            </StackPanel>
            <StackPanel x:Name="ProgressPanel" VerticalAlignment="Center" Spacing="6" Visibility="Collapsed">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="ProgressStage" Style="{StaticResource BodyTextBlockStyle}" TextTrimming="CharacterEllipsis"
                               AutomationProperties.LiveSetting="Polite" />
                    <TextBlock x:Name="ProgressPercent" Grid.Column="1" Style="{StaticResource BodyTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </Grid>
                <ProgressBar x:Name="ProgressBarControl" Minimum="0" Maximum="100" />
                <TextBlock x:Name="ProgressDetail" Style="{StaticResource SecondaryTextStyle}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Bottom">
                <Button x:Name="SecondaryButton" Style="{StaticResource FooterButtonStyle}" Click="OnSecondaryClick" />
                <Button x:Name="PrimaryButton" Style="{StaticResource FooterAccentButtonStyle}" Click="OnPrimaryClick">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon x:Name="PrimaryShield" Glyph="&#xEA18;" FontSize="14" Visibility="Collapsed" />
                        <TextBlock x:Name="PrimaryText" />
                    </StackPanel>
                </Button>
                <Button x:Name="CancelButton" Style="{StaticResource FooterButtonStyle}" Click="OnCancelClick">
                    <Button.KeyboardAccelerators>
                        <KeyboardAccelerator Key="Escape" />
                    </Button.KeyboardAccelerators>
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
