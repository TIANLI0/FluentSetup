<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="FluentSetup.Builder.Views.AppInfoPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:FluentSetup.Builder.Views"
    xmlns:vm="using:FluentSetup.Builder.ViewModels"
    Background="Transparent">
    <ScrollViewer>
        <StackPanel MaxWidth="{StaticResource PageMaxWidth}" Padding="{StaticResource PagePadding}">
            <TextBlock x:Uid="AppPageTitle" Style="{StaticResource PageTitleStyle}" AutomationProperties.HeadingLevel="Level1" />
            <TextBlock x:Uid="AppPageDescription" Style="{StaticResource PageDescriptionStyle}" />

            <TextBlock x:Uid="AppIdentity" Style="{StaticResource SectionHeaderStyle}" />
            <Border Style="{StaticResource RowCardStyle}" Padding="20,16,20,20">
                <Grid ColumnSpacing="24" RowSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel>
                        <TextBox x:Uid="AppNameBox" Text="{x:Bind VM.AppName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Text="{x:Bind VM.Errors.AppName, Mode=OneWay}" Style="{StaticResource FieldErrorStyle}" Visibility="{x:Bind local:Converters.VisibleIfText(VM.Errors.AppName), Mode=OneWay}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBox x:Uid="AppIdBox" Text="{x:Bind VM.AppId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsSpellCheckEnabled="False" />
                        <TextBlock Text="{x:Bind VM.Errors.AppId, Mode=OneWay}" Style="{StaticResource FieldErrorStyle}" Visibility="{x:Bind local:Converters.VisibleIfText(VM.Errors.AppId), Mode=OneWay}" />
                    </StackPanel>
                    <StackPanel Grid.Row="1">
                        <TextBox x:Uid="AppPublisherBox" Text="{x:Bind VM.Publisher, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Text="{x:Bind VM.Errors.AppPublisher, Mode=OneWay}" Style="{StaticResource FieldErrorStyle}" Visibility="{x:Bind local:Converters.VisibleIfText(VM.Errors.AppPublisher), Mode=OneWay}" />
                    </StackPanel>
                    <StackPanel Grid.Row="1" Grid.Column="1">
                        <TextBox x:Uid="AppVersionBox" Text="{x:Bind VM.Version, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsSpellCheckEnabled="False" />
                        <TextBlock Text="{x:Bind VM.Errors.AppVersion, Mode=OneWay}" Style="{StaticResource FieldErrorStyle}" Visibility="{x:Bind local:Converters.VisibleIfText(VM.Errors.AppVersion), Mode=OneWay}" />
                    </StackPanel>
                    <StackPanel Grid.Row="2" Grid.ColumnSpan="2">
                        <TextBox x:Uid="AppDescriptionBox" Text="{x:Bind VM.Description, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 AcceptsReturn="True" TextWrapping="Wrap" MinHeight="64" />
                        <TextBlock Text="{x:Bind VM.Errors.AppDescription, Mode=OneWay}" Style="{StaticResource FieldErrorStyle}" Visibility="{x:Bind local:Converters.VisibleIfText(VM.Errors.AppDescription), Mode=OneWay}" />
                    </StackPanel>
                    <StackPanel Grid.Row="3" Grid.ColumnSpan="2">
                        <TextBox x:Uid="AppWebsiteBox" Text="{x:Bind VM.Website, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsSpellCheckEnabled="False" />
                        <TextBlock Text="{x:Bind VM.Errors.AppWebsite, Mode=OneWay}" Style="{StaticResource FieldErrorStyle}" Visibility="{x:Bind local:Converters.VisibleIfText(VM.Errors.AppWebsite), Mode=OneWay}" />
                    </StackPanel>
                    <StackPanel Grid.Row="4">
                        <TextBox x:Uid="AppSupportUrlBox" Text="{x:Bind VM.SupportUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsSpellCheckEnabled="False" />
                        <TextBlock Text="{x:Bind VM.Errors.AppSupportUrl, Mode=OneWay}" Style="{StaticResource FieldErrorStyle}" Visibility="{x:Bind local:Converters.VisibleIfText(VM.Errors.AppSupportUrl), Mode=OneWay}" />
                    </StackPanel>
                    <StackPanel Grid.Row="4" Grid.Column="1">
                        <TextBox x:Uid="AppReleaseNotesUrlBox" Text="{x:Bind VM.ReleaseNotesUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsSpellCheckEnabled="False" />
                        <TextBlock Text="{x:Bind VM.Errors.AppReleaseNotesUrl, Mode=OneWay}" Style="{StaticResource FieldErrorStyle}" Visibility="{x:Bind local:Converters.VisibleIfText(VM.Errors.AppReleaseNotesUrl), Mode=OneWay}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- app.links: extra links shown in the installer next to the website (at most ProjectValidator.MaxLinks) -->
            <Grid Margin="0,28,0,8">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center" Margin="1,0,16,0">
                    <TextBlock x:Uid="AppLinksSection" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <TextBlock x:Uid="AppLinksDescription" Style="{StaticResource RowDescriptionStyle}" />
                </StackPanel>
                <Button Grid.Column="1" Command="{x:Bind VM.AddLinkCommand}" IsEnabled="{x:Bind VM.CanAddLink, Mode=OneWay}" VerticalAlignment="Bottom">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE710;" FontSize="14" />
                        <TextBlock x:Uid="AppLinksAdd" />
                    </StackPanel>
                </Button>
            </Grid>
            <Border Style="{StaticResource RowCardStyle}" Visibility="{x:Bind VM.HasNoLinks, Mode=OneWay}">
                <TextBlock x:Uid="AppLinksEmpty" Style="{StaticResource RowDescriptionStyle}" VerticalAlignment="Center" />
            </Border>
            <Border Style="{StaticResource RowCardStyle}" Padding="20,16,20,16" Visibility="{x:Bind local:Converters.VisibleIfNot(VM.HasNoLinks), Mode=OneWay}">
                <ItemsControl ItemsSource="{x:Bind VM.LinkRows}" IsTabStop="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><StackPanel Spacing="12" /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:LinkRow">
                            <StackPanel>
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBox x:Uid="AppLinkUrlBox" Text="{x:Bind Url, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsSpellCheckEnabled="False" VerticalAlignment="Top" />
                                    <TextBox x:Uid="AppLinkLabelBox" Grid.Column="1" Text="{x:Bind LabelText, Mode=TwoWay}" Style="{StaticResource LinesBoxStyle}" />
                                    <Button x:Uid="RowRemove" Grid.Column="2" Command="{x:Bind RemoveCommand}" VerticalAlignment="Bottom">
                                        <FontIcon Glyph="&#xE74D;" FontSize="14" />
                                    </Button>
                                </Grid>
                                <TextBlock Text="{x:Bind Error, Mode=OneWay}" Style="{StaticResource FieldErrorStyle}" Visibility="{x:Bind local:Converters.VisibleIfText(Error), Mode=OneWay}" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>
            <TextBlock Text="{x:Bind VM.Errors.AppLinks, Mode=OneWay}" Style="{StaticResource FieldErrorStyle}" Visibility="{x:Bind local:Converters.VisibleIfText(VM.Errors.AppLinks), Mode=OneWay}" />

            <TextBlock x:Uid="AppProgram" Style="{StaticResource SectionHeaderStyle}" />
            <StackPanel Spacing="4">
                <Border Style="{StaticResource RowCardStyle}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <Image Source="{x:Bind VM.IconImage, Mode=OneWay}" Width="28" Height="28" VerticalAlignment="Center" Margin="0,0,0,0"
                               AutomationProperties.AccessibilityView="Raw" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock x:Uid="AppIconTitle" Style="{StaticResource RowTitleStyle}" />
                            <TextBlock Text="{x:Bind IconDescription}" Style="{StaticResource RowDescriptionStyle}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                            <TextBlock Text="{x:Bind VM.Errors.AppIcon, Mode=OneWay}" Style="{StaticResource FieldErrorStyle}" Visibility="{x:Bind local:Converters.VisibleIfText(VM.Errors.AppIcon), Mode=OneWay}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Button x:Uid="AppIconClear" Click="OnClearIcon" />
                            <Button x:Uid="AppIconBrowse" Command="{x:Bind VM.BrowseIconCommand}" />
                        </StackPanel>
                    </Grid>
                </Border>
                <Border Style="{StaticResource RowCardStyle}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE756;" Style="{StaticResource RowIconStyle}" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock x:Uid="AppMainExeTitle" Style="{StaticResource RowTitleStyle}" />
                            <TextBlock x:Uid="AppMainExeDescription" Style="{StaticResource RowDescriptionStyle}" />
                            <TextBlock Text="{x:Bind VM.Errors.AppMainExecutable, Mode=OneWay}" Style="{StaticResource FieldErrorStyle}" Visibility="{x:Bind local:Converters.VisibleIfText(VM.Errors.AppMainExecutable), Mode=OneWay}" />
                        </StackPanel>
                        <ComboBox Grid.Column="2" ItemsSource="{x:Bind VM.ExecutableChoices}" MinWidth="260" VerticalAlignment="Center"
                                  SelectedItem="{x:Bind VM.MainExecutableItem, Mode=TwoWay}" x:Uid="AppMainExeCombo" />
                    </Grid>
                </Border>
                <Border Style="{StaticResource RowCardStyle}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE8A5;" Style="{StaticResource RowIconStyle}" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock x:Uid="AppLicenseTitle" Style="{StaticResource RowTitleStyle}" />
                            <TextBlock Text="{x:Bind LicenseDescription}" Style="{StaticResource RowDescriptionStyle}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                            <TextBlock Text="{x:Bind VM.Errors.UiLicense, Mode=OneWay}" Style="{StaticResource FieldErrorStyle}" Visibility="{x:Bind local:Converters.VisibleIfText(VM.Errors.UiLicense), Mode=OneWay}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Button x:Uid="AppLicenseClear" Click="OnClearLicense" />
                            <Button x:Uid="AppLicenseBrowse" Command="{x:Bind VM.BrowseLicenseCommand}" />
                        </StackPanel>
                    </Grid>
                </Border>
                <Border Style="{StaticResource RowCardStyle}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xF2B7;" Style="{StaticResource RowIconStyle}" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock x:Uid="AppLanguageTitle" Style="{StaticResource RowTitleStyle}" />
                            <TextBlock x:Uid="AppLanguageDescription" Style="{StaticResource RowDescriptionStyle}" />
                        </StackPanel>
                        <ComboBox Grid.Column="2" Style="{StaticResource RowComboStyle}" SelectedIndex="{x:Bind VM.LanguageIndex, Mode=TwoWay}" x:Uid="AppLanguageCombo">
                            <!-- same order as Localization.SupportedLanguages (MainViewModel.Languages) -->
                            <ComboBoxItem x:Uid="LanguageAuto" />
                            <ComboBoxItem Content="English (en-US)" />
                            <ComboBoxItem Content="简体中文 (zh-CN)" />
                            <ComboBoxItem Content="繁體中文 (zh-TW)" />
                            <ComboBoxItem Content="日本語 (ja-JP)" />
                            <ComboBoxItem Content="한국어 (ko-KR)" />
                            <ComboBoxItem Content="Deutsch (de-DE)" />
                            <ComboBoxItem Content="Français (fr-FR)" />
                            <ComboBoxItem Content="Español (es-ES)" />
                            <ComboBoxItem Content="Português (pt-BR)" />
                            <ComboBoxItem Content="Русский (ru-RU)" />
                            <ComboBoxItem Content="Italiano (it-IT)" />
                            <!-- any other language tag: the package brings its strings (ui.strings or ui.localization) -->
                            <ComboBoxItem x:Uid="LanguageOther" />
                        </ComboBox>
                    </Grid>
                </Border>
                <Border Style="{StaticResource RowCardStyle}" Visibility="{x:Bind VM.IsOtherLanguage, Mode=OneWay}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE775;" Style="{StaticResource RowIconStyle}" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock x:Uid="AppOtherLanguageTitle" Style="{StaticResource RowTitleStyle}" />
                            <TextBlock x:Uid="AppOtherLanguageDescription" Style="{StaticResource RowDescriptionStyle}" />
                            <TextBlock Text="{x:Bind VM.Errors.UiDefaultLanguage, Mode=OneWay}" Style="{StaticResource FieldErrorStyle}" Visibility="{x:Bind local:Converters.VisibleIfText(VM.Errors.UiDefaultLanguage), Mode=OneWay}" />
                        </StackPanel>
                        <TextBox Grid.Column="2" Text="{x:Bind VM.OtherLanguage, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="160" VerticalAlignment="Center" IsSpellCheckEnabled="False" x:Uid="AppOtherLanguageBox" />
                    </Grid>
                </Border>
            </StackPanel>

            <!-- AppUserModelID and toast activator set on the app's own shortcuts (notifications of unpackaged apps) -->
            <TextBlock x:Uid="AppNotificationsSection" Style="{StaticResource SectionHeaderStyle}" />
            <Border Style="{StaticResource RowCardStyle}" Padding="20,16,20,20">
                <StackPanel Spacing="16">
                    <TextBlock x:Uid="AppNotificationsDescription" Style="{StaticResource RowDescriptionStyle}" />
                    <Grid ColumnSpacing="24">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBox x:Uid="AppAumidBox" Text="{x:Bind VM.AppUserModelId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsSpellCheckEnabled="False" />
                            <TextBlock Text="{x:Bind VM.Errors.AppUserModelId, Mode=OneWay}" Style="{StaticResource FieldErrorStyle}" Visibility="{x:Bind local:Converters.VisibleIfText(VM.Errors.AppUserModelId), Mode=OneWay}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBox x:Uid="AppToastClsidBox" Text="{x:Bind VM.ToastActivatorClsid, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas" IsSpellCheckEnabled="False" />
                                <Button x:Uid="AppToastClsidGenerate" Grid.Column="1" VerticalAlignment="Bottom" Command="{x:Bind VM.GenerateToastActivatorClsidCommand}" />
                            </Grid>
                            <TextBlock Text="{x:Bind VM.Errors.AppToastActivatorClsid, Mode=OneWay}" Style="{StaticResource FieldErrorStyle}" Visibility="{x:Bind local:Converters.VisibleIfText(VM.Errors.AppToastActivatorClsid), Mode=OneWay}" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <TextBlock x:Uid="AppOutputSection" Style="{StaticResource SectionHeaderStyle}" />
            <Border Style="{StaticResource RowCardStyle}" Padding="20,16,20,20">
                <StackPanel>
                    <TextBox x:Uid="AppOutputNameBox" Text="{x:Bind VM.OutputFileName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsSpellCheckEnabled="False" />
                    <TextBlock Text="{x:Bind VM.Errors.OutputFileName, Mode=OneWay}" Style="{StaticResource FieldErrorStyle}" Visibility="{x:Bind local:Converters.VisibleIfText(VM.Errors.OutputFileName), Mode=OneWay}" />
                    <TextBlock Text="{x:Bind VM.OutputSummary, Mode=OneWay}" Style="{StaticResource RowDescriptionStyle}" Margin="0,8,0,0" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
