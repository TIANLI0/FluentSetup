<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="FluentSetup.Builder.Views.PrerequisiteSourceView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:FluentSetup.Builder.Views">
    <!-- How setup gets a missing prerequisite: a bundled installer first, else a verified download. -->
    <StackPanel Spacing="16">
        <TextBlock x:Uid="SourceHelp" Style="{StaticResource RowDescriptionStyle}" />
        <local:ProgramBox x:Uid="SourceInstallerCombo" Choices="{x:Bind VM.ExecutableChoices}" Text="{x:Bind Source.Installer, Mode=TwoWay}" />
        <Grid ColumnSpacing="24" RowSpacing="16">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <TextBox x:Uid="SourceArgumentsBox" Grid.RowSpan="3" Text="{x:Bind Source.ArgumentsText, Mode=TwoWay}" AcceptsReturn="True"
                     MinHeight="96" FontFamily="Consolas" IsSpellCheckEnabled="False" />
            <ComboBox x:Uid="SourceOnFailureCombo" Grid.Column="1" HorizontalAlignment="Stretch" SelectedIndex="{x:Bind Source.OnFailureIndex, Mode=TwoWay}">
                <ComboBoxItem x:Uid="SourceOnFailureWarn" />
                <ComboBoxItem x:Uid="SourceOnFailureFail" />
            </ComboBox>
            <TextBox x:Uid="SourceHelpUrlBox" Grid.Row="1" Grid.Column="1" Text="{x:Bind Source.HelpUrl, Mode=TwoWay}" IsSpellCheckEnabled="False" />
            <TextBox x:Uid="SourceVariantsBox" Grid.Row="2" Grid.Column="1" Text="{x:Bind Source.VariantsText, Mode=TwoWay}" IsSpellCheckEnabled="False" />
        </Grid>
        <ToggleSwitch x:Uid="SourceDownloadToggle" IsOn="{x:Bind Source.HasDownload, Mode=TwoWay}" />
        <StackPanel Spacing="16" Visibility="{x:Bind Source.HasDownload, Mode=OneWay}">
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <TextBox x:Uid="SourceUrlBox" Text="{x:Bind Source.DownloadUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsSpellCheckEnabled="False" />
                <Button x:Uid="SourceComputeButton" Grid.Column="1" VerticalAlignment="Bottom" Command="{x:Bind Source.ComputeDownloadCommand}" />
            </Grid>
            <Grid ColumnSpacing="24">
                <Grid.ColumnDefinitions><ColumnDefinition Width="2*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <TextBox x:Uid="SourceSha256Box" Text="{x:Bind Source.DownloadSha256, Mode=TwoWay}" FontFamily="Consolas" IsSpellCheckEnabled="False" />
                <NumberBox x:Uid="SourceSizeBox" Grid.Column="1" Value="{x:Bind Source.DownloadSize, Mode=TwoWay}" Minimum="0" SpinButtonPlacementMode="Hidden" />
            </Grid>
            <StackPanel Orientation="Horizontal" Spacing="12" Visibility="{x:Bind local:Converters.VisibleIfText(Source.ComputeStatus), Mode=OneWay}">
                <ProgressRing IsActive="{x:Bind Source.IsComputing, Mode=OneWay}" Width="16" Height="16" Visibility="{x:Bind Source.IsComputing, Mode=OneWay}" />
                <TextBlock Text="{x:Bind Source.ComputeStatus, Mode=OneWay}" Style="{StaticResource RowDescriptionStyle}" VerticalAlignment="Center"
                           IsTextSelectionEnabled="True" AutomationProperties.LiveSetting="Polite" />
                <HyperlinkButton x:Uid="SourceComputeCancel" Command="{x:Bind Source.ComputeDownloadCancelCommand}" Visibility="{x:Bind Source.IsComputing, Mode=OneWay}"
                                 Padding="4,2" VerticalAlignment="Center" />
            </StackPanel>
        </StackPanel>
    </StackPanel>
</UserControl>
