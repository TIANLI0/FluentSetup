<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="FluentSetup.Builder.Views.VersionBox"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:FluentSetup.Builder.Views"
    xmlns:vm="using:FluentSetup.Builder.ViewModels"
    IsTabStop="False">
    <!-- A version field with the versions Microsoft publishes as suggestions (any valid version can still be typed),
         a refresh button and where the list comes from. -->
    <StackPanel Spacing="4">
        <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <AutoSuggestBox x:Name="Box" TextChanged="OnTextChanged" QuerySubmitted="OnQuerySubmitted" SuggestionChosen="OnSuggestionChosen"
                            UpdateTextOnSelect="False" GotFocus="OnGotFocus">
                <AutoSuggestBox.QueryIcon>
                    <FontIcon Glyph="&#xE70D;" FontSize="12" />
                </AutoSuggestBox.QueryIcon>
                <AutoSuggestBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:VersionSuggestion">
                        <StackPanel Padding="0,6" AutomationProperties.Name="{x:Bind Version}">
                            <TextBlock Text="{x:Bind Version}" FontFamily="Consolas" />
                            <TextBlock Text="{x:Bind Detail}" Style="{StaticResource RowDescriptionStyle}" />
                        </StackPanel>
                    </DataTemplate>
                </AutoSuggestBox.ItemTemplate>
            </AutoSuggestBox>
            <Button x:Uid="VersionRefreshButton" Grid.Column="1" VerticalAlignment="Bottom" Command="{x:Bind Catalog.RefreshCommand, Mode=OneWay}"
                    Visibility="{x:Bind local:Converters.VisibleIf(Catalog.CanRefresh), Mode=OneWay}">
                <FontIcon Glyph="&#xE72C;" FontSize="14" />
            </Button>
        </Grid>
        <StackPanel Orientation="Horizontal" Spacing="8">
            <ProgressRing Width="12" Height="12" IsActive="{x:Bind Catalog.IsLoading, Mode=OneWay}"
                          Visibility="{x:Bind local:Converters.VisibleIf(Catalog.IsLoading), Mode=OneWay}" />
            <TextBlock Text="{x:Bind Catalog.Status, Mode=OneWay}" Style="{StaticResource RowDescriptionStyle}" AutomationProperties.LiveSetting="Polite" />
        </StackPanel>
    </StackPanel>
</UserControl>
