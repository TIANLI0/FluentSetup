<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="FluentSetup.Builder.Views.FilesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:FluentSetup.Builder.ViewModels"
    xmlns:local="using:FluentSetup.Builder.Views"
    Background="Transparent">
    <ScrollViewer>
        <StackPanel MaxWidth="{StaticResource PageMaxWidth}" Padding="{StaticResource PagePadding}">
            <TextBlock x:Uid="FilesPageTitle" Style="{StaticResource PageTitleStyle}" AutomationProperties.HeadingLevel="Level1" />
            <TextBlock x:Uid="FilesPageDescription" Style="{StaticResource PageDescriptionStyle}" />

            <TextBlock x:Uid="FilesSourceSection" Style="{StaticResource SectionHeaderStyle}" />
            <Border Style="{StaticResource RowCardStyle}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE8B7;" Style="{StaticResource RowIconStyle}" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Uid="FilesSourceTitle" Style="{StaticResource RowTitleStyle}" />
                        <TextBox Text="{x:Bind VM.Source, Mode=TwoWay}" x:Uid="FilesSourceBox" Margin="0,8,0,0" IsSpellCheckEnabled="False" />
                        <TextBlock Text="{x:Bind VM.Errors.FilesSource, Mode=OneWay}" Style="{StaticResource FieldErrorStyle}" Visibility="{x:Bind local:Converters.VisibleIfText(VM.Errors.FilesSource), Mode=OneWay}" />
                    </StackPanel>
                    <Button Grid.Column="2" x:Uid="FilesBrowse" Command="{x:Bind VM.BrowseSourceCommand}" VerticalAlignment="Center" />
                </Grid>
            </Border>

            <Expander x:Uid="FilesRulesExpander" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Margin="0,4,0,0">
                <Grid ColumnSpacing="24" RowSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBox x:Uid="FilesIncludeBox" Text="{x:Bind VM.IncludeText, Mode=TwoWay}" AcceptsReturn="True" MinHeight="96" FontFamily="Consolas" IsSpellCheckEnabled="False" />
                    <TextBox x:Uid="FilesExcludeBox" Grid.Column="1" Text="{x:Bind VM.ExcludeText, Mode=TwoWay}" AcceptsReturn="True" MinHeight="96" FontFamily="Consolas" IsSpellCheckEnabled="False" />
                    <TextBox x:Uid="FilesEmptyDirsBox" Grid.Row="1" Text="{x:Bind VM.EmptyDirectoriesText, Mode=TwoWay}" AcceptsReturn="True" MinHeight="64" FontFamily="Consolas" IsSpellCheckEnabled="False" />
                    <TextBlock x:Uid="FilesPatternHelp" Grid.Row="1" Grid.Column="1" Style="{StaticResource RowDescriptionStyle}" VerticalAlignment="Top" Margin="0,28,0,0" />
                    <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Spacing="8">
                        <Grid>
                            <TextBlock x:Uid="FilesExtraTitle" Style="{StaticResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" />
                            <Button x:Uid="FilesAddExtra" HorizontalAlignment="Right" Command="{x:Bind VM.AddExtraSourceCommand}" />
                        </Grid>
                        <ItemsRepeater ItemsSource="{x:Bind VM.ExtraSources}">
                            <ItemsRepeater.Layout><StackLayout Spacing="8" /></ItemsRepeater.Layout>
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="vm:ExtraSourceRow">
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="2*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <TextBox Text="{x:Bind Source, Mode=TwoWay}" PlaceholderText="C:\path\to\folder" IsSpellCheckEnabled="False" />
                                        <TextBox Grid.Column="1" Text="{x:Bind Target, Mode=TwoWay}" PlaceholderText="subfolder" IsSpellCheckEnabled="False" />
                                        <Button Grid.Column="2" Click="OnRemoveExtra" Tag="{x:Bind}" x:Uid="FilesRemoveExtra">
                                            <FontIcon Glyph="&#xE74D;" FontSize="14" />
                                        </Button>
                                    </Grid>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                    </StackPanel>
                </Grid>
            </Expander>

            <Grid Margin="0,28,0,8">
                <TextBlock x:Uid="FilesListSection" Style="{StaticResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" />
                <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Right">
                    <ProgressRing IsActive="{x:Bind VM.IsCollecting, Mode=OneWay}" Width="16" Height="16" />
                    <TextBlock Text="{x:Bind VM.FilesSummary, Mode=OneWay}" Style="{StaticResource BodyTextBlockStyle}" VerticalAlignment="Center"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <Button x:Uid="FilesRefresh" Command="{x:Bind VM.RefreshFilesCommand}">
                        <FontIcon Glyph="&#xE72C;" FontSize="14" />
                    </Button>
                </StackPanel>
            </Grid>

            <ItemsRepeater ItemsSource="{x:Bind VM.FileProblems}" Visibility="{x:Bind VM.HasFileProblems, Mode=OneWay}" Margin="0,0,0,8">
                <ItemsRepeater.Layout><StackLayout Spacing="4" /></ItemsRepeater.Layout>
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="vm:ProblemRow">
                        <InfoBar IsOpen="True" IsClosable="False" Severity="{x:Bind local:Converters.ToSeverity(Severity)}" Message="{x:Bind Message}" Title="{x:Bind Code}" />
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>

            <Border Style="{StaticResource RowCardStyle}" Padding="0" MinHeight="0">
                <ListView ItemsSource="{x:Bind VM.Files}" SelectionMode="None" MaxHeight="420" Padding="0,4">
                    <ListView.Header>
                        <Grid Padding="16,8,28,8" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock x:Uid="FilesColumnPath" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock x:Uid="FilesColumnSize" Grid.Column="1" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </Grid>
                    </ListView.Header>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:FileRow">
                            <Grid ColumnSpacing="12" Padding="0,2">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <FontIcon Glyph="&#xE8A5;" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Grid.Column="1" Text="{x:Bind RelativePath}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2" Text="{x:Bind SizeText}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
