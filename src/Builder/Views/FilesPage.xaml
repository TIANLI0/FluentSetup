<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="FluentSetup.Builder.Views.FilesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:FluentSetup.Builder.ViewModels"
    xmlns:local="using:FluentSetup.Builder.Views"
    Background="Transparent">
    <ScrollViewer>
        <StackPanel MaxWidth="{StaticResource PageMaxWidth}" Padding="{StaticResource PagePadding}">
            <TextBlock x:Uid="FilesPageTitle" Style="{StaticResource PageTitleStyle}" AutomationProperties.HeadingLevel="Level1" />
            <TextBlock x:Uid="FilesPageDescription" Style="{StaticResource PageDescriptionStyle}" />

            <TextBlock x:Uid="FilesSourceSection" Style="{StaticResource SectionHeaderStyle}" />
            <Border Style="{StaticResource RowCardStyle}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE8B7;" Style="{StaticResource RowIconStyle}" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Uid="FilesSourceTitle" Style="{StaticResource RowTitleStyle}" />
                        <TextBox Text="{x:Bind VM.Source, Mode=TwoWay}" x:Uid="FilesSourceBox" Margin="0,8,0,0" IsSpellCheckEnabled="False" />
                        <TextBlock Text="{x:Bind VM.Errors.FilesSource, Mode=OneWay}" Style="{StaticResource FieldErrorStyle}" Visibility="{x:Bind local:Converters.VisibleIfText(VM.Errors.FilesSource), Mode=OneWay}" />
                    </StackPanel>
                    <Button Grid.Column="2" x:Uid="FilesBrowse" Command="{x:Bind VM.BrowseSourceCommand}" VerticalAlignment="Center" />
                </Grid>
            </Border>

            <Expander x:Uid="FilesRulesExpander" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Margin="0,4,0,0">
                <Grid ColumnSpacing="24" RowSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBox x:Uid="FilesIncludeBox" Text="{x:Bind VM.IncludeText, Mode=TwoWay}" MinHeight="96" Style="{StaticResource LinesBoxStyle}" />
                    <TextBox x:Uid="FilesExcludeBox" Grid.Column="1" Text="{x:Bind VM.ExcludeText, Mode=TwoWay}" MinHeight="96" Style="{StaticResource LinesBoxStyle}" />
                    <TextBox x:Uid="FilesEmptyDirsBox" Grid.Row="1" Text="{x:Bind VM.EmptyDirectoriesText, Mode=TwoWay}" MinHeight="64" Style="{StaticResource LinesBoxStyle}" />
                    <TextBlock x:Uid="FilesPatternHelp" Grid.Row="1" Grid.Column="1" Style="{StaticResource RowDescriptionStyle}" VerticalAlignment="Top" Margin="0,28,0,0" />
                    <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Spacing="8">
                        <Grid>
                            <TextBlock x:Uid="FilesExtraTitle" Style="{StaticResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" />
                            <Button x:Uid="FilesAddExtra" HorizontalAlignment="Right" Command="{x:Bind VM.AddExtraSourceCommand}" />
                        </Grid>
                        <ItemsRepeater ItemsSource="{x:Bind VM.ExtraSources}">
                            <ItemsRepeater.Layout><StackLayout Spacing="8" /></ItemsRepeater.Layout>
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="vm:ExtraSourceRow">
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="2*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <TextBox Text="{x:Bind Source, Mode=TwoWay}" PlaceholderText="C:\path\to\folder" IsSpellCheckEnabled="False" />
                                        <TextBox Grid.Column="1" Text="{x:Bind Target, Mode=TwoWay}" PlaceholderText="subfolder" IsSpellCheckEnabled="False" />
                                        <Button Grid.Column="2" Click="OnRemoveExtra" Tag="{x:Bind}" x:Uid="FilesRemoveExtra">
                                            <FontIcon Glyph="&#xE74D;" FontSize="14" />
                                        </Button>
                                    </Grid>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                    </StackPanel>
                </Grid>
            </Expander>

            <!-- Variants: alternative builds of the app, each with its own source folder -->
            <Grid Margin="0,28,0,8">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center" Margin="1,0,16,0">
                    <TextBlock x:Uid="VariantsSection" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <TextBlock x:Uid="VariantsDescription" Style="{StaticResource RowDescriptionStyle}" />
                </StackPanel>
                <Button Grid.Column="1" Command="{x:Bind VM.AddVariantCommand}" VerticalAlignment="Bottom">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE710;" FontSize="14" />
                        <TextBlock x:Uid="VariantsAdd" />
                    </StackPanel>
                </Button>
            </Grid>
            <ItemsControl ItemsSource="{x:Bind VM.VariantRows}" IsTabStop="False">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><StackPanel Spacing="4" /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:VariantRow">
                        <Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" IsExpanded="{x:Bind IsExpanded, Mode=TwoWay}">
                            <Expander.Header>
                                <Grid ColumnSpacing="16" Padding="0,12">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <FontIcon Glyph="&#xE8F1;" Style="{StaticResource RowIconStyle}" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind Title, Mode=OneWay}" Style="{StaticResource RowTitleStyle}" />
                                        <TextBlock Text="{x:Bind Subtitle, Mode=OneWay}" Style="{StaticResource RowDescriptionStyle}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                                        <Button x:Uid="RowMoveUp" Command="{x:Bind MoveUpCommand}" Background="Transparent" BorderThickness="0" Padding="8">
                                            <FontIcon Glyph="&#xE70E;" FontSize="14" />
                                        </Button>
                                        <Button x:Uid="RowMoveDown" Command="{x:Bind MoveDownCommand}" Background="Transparent" BorderThickness="0" Padding="8">
                                            <FontIcon Glyph="&#xE70D;" FontSize="14" />
                                        </Button>
                                        <Button x:Uid="RowRemove" Command="{x:Bind RemoveCommand}" Background="Transparent" BorderThickness="0" Padding="8">
                                            <FontIcon Glyph="&#xE74D;" FontSize="14" />
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Expander.Header>
                            <StackPanel Spacing="16" Padding="40,4,0,4">
                                <Grid ColumnSpacing="24" RowSpacing="16">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                    <TextBox x:Uid="VariantIdBox" Text="{x:Bind Id, Mode=TwoWay}" IsSpellCheckEnabled="False" />
                                    <CheckBox x:Uid="VariantDefaultCheck" Grid.Column="1" IsChecked="{x:Bind Default, Mode=TwoWay}" VerticalAlignment="Bottom" />
                                    <Grid Grid.Row="1" Grid.ColumnSpan="2" ColumnSpacing="8">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <TextBox x:Uid="VariantSourceBox" Text="{x:Bind Source, Mode=TwoWay}" IsSpellCheckEnabled="False" />
                                        <Button x:Uid="FilesBrowse" Grid.Column="1" Command="{x:Bind BrowseCommand}" VerticalAlignment="Bottom" />
                                    </Grid>
                                    <TextBox x:Uid="VariantLabelBox" Grid.Row="2" Text="{x:Bind LabelText, Mode=TwoWay}" MinHeight="64" Style="{StaticResource LinesBoxStyle}" />
                                    <TextBox x:Uid="VariantDescriptionBox" Grid.Row="2" Grid.Column="1" Text="{x:Bind DescriptionText, Mode=TwoWay}" MinHeight="64" Style="{StaticResource LinesBoxStyle}" />
                                </Grid>
                                <TextBlock Text="{x:Bind Error, Mode=OneWay}" Style="{StaticResource FieldErrorStyle}" Visibility="{x:Bind local:Converters.VisibleIfText(Error), Mode=OneWay}" />
                            </StackPanel>
                        </Expander>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Border Style="{StaticResource RowCardStyle}" Margin="0,4,0,0" Visibility="{x:Bind VM.HasVariants, Mode=OneWay}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE7B8;" Style="{StaticResource RowIconStyle}" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Uid="VariantsOutputTitle" Style="{StaticResource RowTitleStyle}" />
                        <TextBlock x:Uid="VariantsOutputDescription" Style="{StaticResource RowDescriptionStyle}" />
                        <TextBlock Text="{x:Bind VM.Errors.OutputVariants, Mode=OneWay}" Style="{StaticResource FieldErrorStyle}" Visibility="{x:Bind local:Converters.VisibleIfText(VM.Errors.OutputVariants), Mode=OneWay}" />
                    </StackPanel>
                    <TextBox Grid.Column="2" Text="{x:Bind VM.OutputVariantsText, Mode=TwoWay}" Width="240" VerticalAlignment="Center" IsSpellCheckEnabled="False" x:Uid="VariantsOutputBox" />
                </Grid>
            </Border>
            <TextBlock Text="{x:Bind VM.Errors.FilesVariants, Mode=OneWay}" Style="{StaticResource FieldErrorStyle}" Visibility="{x:Bind local:Converters.VisibleIfText(VM.Errors.FilesVariants), Mode=OneWay}" />

            <Grid Margin="0,28,0,8">
                <TextBlock x:Uid="FilesListSection" Style="{StaticResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" />
                <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Right">
                    <ProgressRing IsActive="{x:Bind VM.IsCollecting, Mode=OneWay}" Width="16" Height="16" />
                    <TextBlock Text="{x:Bind VM.FilesSummary, Mode=OneWay}" Style="{StaticResource BodyTextBlockStyle}" VerticalAlignment="Center"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <Button x:Uid="FilesRefresh" Command="{x:Bind VM.RefreshFilesCommand}">
                        <FontIcon Glyph="&#xE72C;" FontSize="14" />
                    </Button>
                </StackPanel>
            </Grid>

            <ItemsRepeater ItemsSource="{x:Bind VM.FileProblems}" Visibility="{x:Bind VM.HasFileProblems, Mode=OneWay}" Margin="0,0,0,8">
                <ItemsRepeater.Layout><StackLayout Spacing="4" /></ItemsRepeater.Layout>
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="vm:ProblemRow">
                        <InfoBar IsOpen="True" IsClosable="False" Severity="{x:Bind local:Converters.ToSeverity(Severity)}" Message="{x:Bind Message}" Title="{x:Bind Code}" />
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>

            <Border Style="{StaticResource RowCardStyle}" Padding="0" MinHeight="0">
                <ListView ItemsSource="{x:Bind VM.Files}" SelectionMode="None" MaxHeight="420" Padding="0,4">
                    <ListView.Header>
                        <Grid Padding="16,8,28,8" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock x:Uid="FilesColumnPath" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock x:Uid="FilesColumnSize" Grid.Column="1" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </Grid>
                    </ListView.Header>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:FileRow">
                            <Grid ColumnSpacing="12" Padding="0,2">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <FontIcon Glyph="&#xE8A5;" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Grid.Column="1" Text="{x:Bind RelativePath}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2" Text="{x:Bind SizeText}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
