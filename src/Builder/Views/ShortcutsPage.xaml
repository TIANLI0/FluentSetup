<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="FluentSetup.Builder.Views.ShortcutsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:FluentSetup.Builder.Views"
    xmlns:vm="using:FluentSetup.Builder.ViewModels"
    Background="Transparent">
    <ScrollViewer>
        <StackPanel MaxWidth="{StaticResource PageMaxWidth}" Padding="{StaticResource PagePadding}">
            <TextBlock x:Uid="ShortcutsPageTitle" Style="{StaticResource PageTitleStyle}" AutomationProperties.HeadingLevel="Level1" />
            <TextBlock x:Uid="ShortcutsPageDescription" Style="{StaticResource PageDescriptionStyle}" />

            <!-- More shortcuts -->
            <Grid Margin="0,28,0,8">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center" Margin="1,0,16,0">
                    <TextBlock x:Uid="ShortcutsSection" Style="{StaticResource BodyStrongTextBlockStyle}" AutomationProperties.HeadingLevel="Level2" />
                    <TextBlock x:Uid="ShortcutsSectionDescription" Style="{StaticResource RowDescriptionStyle}" />
                </StackPanel>
                <Button Grid.Column="1" Command="{x:Bind VM.AddShortcutCommand}" VerticalAlignment="Bottom">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE710;" FontSize="14" />
                        <TextBlock x:Uid="ShortcutsAdd" />
                    </StackPanel>
                </Button>
            </Grid>
            <Border Style="{StaticResource RowCardStyle}" Visibility="{x:Bind VM.HasNoShortcuts, Mode=OneWay}">
                <TextBlock x:Uid="ShortcutsEmpty" Style="{StaticResource RowDescriptionStyle}" VerticalAlignment="Center" />
            </Border>
            <ItemsControl ItemsSource="{x:Bind VM.ShortcutRows}" IsTabStop="False">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><StackPanel Spacing="4" /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:ShortcutRow">
                        <Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" IsExpanded="{x:Bind IsExpanded, Mode=TwoWay}">
                            <Expander.Header>
                                <Grid ColumnSpacing="16" Padding="0,12">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <FontIcon Glyph="&#xE71B;" Style="{StaticResource RowIconStyle}" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind Title, Mode=OneWay}" Style="{StaticResource RowTitleStyle}" />
                                        <TextBlock Text="{x:Bind Subtitle, Mode=OneWay}" Style="{StaticResource RowDescriptionStyle}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                                        <Button x:Uid="RowMoveUp" Command="{x:Bind MoveUpCommand}" Background="Transparent" BorderThickness="0" Padding="8">
                                            <FontIcon Glyph="&#xE70E;" FontSize="14" />
                                        </Button>
                                        <Button x:Uid="RowMoveDown" Command="{x:Bind MoveDownCommand}" Background="Transparent" BorderThickness="0" Padding="8">
                                            <FontIcon Glyph="&#xE70D;" FontSize="14" />
                                        </Button>
                                        <Button x:Uid="RowRemove" Command="{x:Bind RemoveCommand}" Background="Transparent" BorderThickness="0" Padding="8">
                                            <FontIcon Glyph="&#xE74D;" FontSize="14" />
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Expander.Header>
                            <StackPanel Spacing="16" Padding="40,4,0,4">
                                <Grid ColumnSpacing="24" RowSpacing="16">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBox x:Uid="ShortcutNameBox" Text="{x:Bind Name, Mode=TwoWay}" />
                                    <ComboBox x:Uid="ShortcutLocationCombo" Grid.Column="1" HorizontalAlignment="Stretch" SelectedIndex="{x:Bind LocationIndex, Mode=TwoWay}">
                                        <ComboBoxItem x:Uid="ShortcutLocationStartMenu" />
                                        <ComboBoxItem x:Uid="ShortcutLocationDesktop" />
                                        <ComboBoxItem x:Uid="ShortcutLocationStartup" />
                                    </ComboBox>
                                    <local:ProgramBox x:Uid="ShortcutTargetCombo" Grid.Row="1" Choices="{x:Bind ExecutableChoices}" Text="{x:Bind Target, Mode=TwoWay}" />
                                    <TextBox x:Uid="ShortcutFolderBox" Grid.Row="1" Grid.Column="1" Text="{x:Bind Folder, Mode=TwoWay}" IsSpellCheckEnabled="False"
                                             IsEnabled="{x:Bind IsStartMenu, Mode=OneWay}" />
                                    <TextBox x:Uid="ShortcutArgumentsBox" Grid.Row="2" Text="{x:Bind ArgumentsText, Mode=TwoWay}" MinHeight="64" Style="{StaticResource LinesBoxStyle}" />
                                    <TextBox x:Uid="ShortcutDescriptionBox" Grid.Row="2" Grid.Column="1" Text="{x:Bind Description, Mode=TwoWay}" VerticalAlignment="Top" />
                                    <Grid Grid.Row="3" ColumnSpacing="16">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <local:ProgramBox x:Uid="ShortcutIconCombo" Choices="{x:Bind IconChoices}" Text="{x:Bind Icon, Mode=TwoWay}" />
                                        <NumberBox x:Uid="IconIndexBox" Grid.Column="1" Value="{x:Bind IconIndex, Mode=TwoWay}" Minimum="-65535" Maximum="65535"
                                                   SpinButtonPlacementMode="Compact" MinWidth="120" />
                                    </Grid>
                                    <TextBox x:Uid="ShortcutWorkingDirBox" Grid.Row="3" Grid.Column="1" Text="{x:Bind WorkingDirectory, Mode=TwoWay}" IsSpellCheckEnabled="False" />
                                    <ComboBox x:Uid="IfOptionCombo" Grid.Row="4" HorizontalAlignment="Stretch"
                                              ItemsSource="{x:Bind IfOptionChoices}" SelectedItem="{x:Bind IfOptionItem, Mode=TwoWay}" />
                                    <TextBox x:Uid="ShortcutAumidBox" Grid.Row="4" Grid.Column="1" Text="{x:Bind AppUserModelId, Mode=TwoWay}" IsSpellCheckEnabled="False" />
                                </Grid>
                                <TextBlock Text="{x:Bind Error, Mode=OneWay}" Style="{StaticResource FieldErrorStyle}" Visibility="{x:Bind local:Converters.VisibleIfText(Error), Mode=OneWay}" />
                            </StackPanel>
                        </Expander>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="{x:Bind VM.Errors.Shortcuts, Mode=OneWay}" Style="{StaticResource FieldErrorStyle}" Visibility="{x:Bind local:Converters.VisibleIfText(VM.Errors.Shortcuts), Mode=OneWay}" />

            <!-- File types -->
            <Grid Margin="0,28,0,8">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center" Margin="1,0,16,0">
                    <TextBlock x:Uid="AssociationsSection" Style="{StaticResource BodyStrongTextBlockStyle}" AutomationProperties.HeadingLevel="Level2" />
                    <TextBlock x:Uid="AssociationsSectionDescription" Style="{StaticResource RowDescriptionStyle}" />
                </StackPanel>
                <Button Grid.Column="1" Command="{x:Bind VM.AddAssociationCommand}" VerticalAlignment="Bottom">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE710;" FontSize="14" />
                        <TextBlock x:Uid="AssociationsAdd" />
                    </StackPanel>
                </Button>
            </Grid>
            <Border Style="{StaticResource RowCardStyle}" Visibility="{x:Bind VM.HasNoAssociations, Mode=OneWay}">
                <TextBlock x:Uid="AssociationsEmpty" Style="{StaticResource RowDescriptionStyle}" VerticalAlignment="Center" />
            </Border>
            <ItemsControl ItemsSource="{x:Bind VM.AssociationRows}" IsTabStop="False">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><StackPanel Spacing="4" /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:AssociationRow">
                        <Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" IsExpanded="{x:Bind IsExpanded, Mode=TwoWay}">
                            <Expander.Header>
                                <Grid ColumnSpacing="16" Padding="0,12">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <FontIcon Glyph="&#xE8A5;" Style="{StaticResource RowIconStyle}" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind Title, Mode=OneWay}" Style="{StaticResource RowTitleStyle}" />
                                        <TextBlock Text="{x:Bind Subtitle, Mode=OneWay}" Style="{StaticResource RowDescriptionStyle}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                                        <Button x:Uid="RowMoveUp" Command="{x:Bind MoveUpCommand}" Background="Transparent" BorderThickness="0" Padding="8">
                                            <FontIcon Glyph="&#xE70E;" FontSize="14" />
                                        </Button>
                                        <Button x:Uid="RowMoveDown" Command="{x:Bind MoveDownCommand}" Background="Transparent" BorderThickness="0" Padding="8">
                                            <FontIcon Glyph="&#xE70D;" FontSize="14" />
                                        </Button>
                                        <Button x:Uid="RowRemove" Command="{x:Bind RemoveCommand}" Background="Transparent" BorderThickness="0" Padding="8">
                                            <FontIcon Glyph="&#xE74D;" FontSize="14" />
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Expander.Header>
                            <StackPanel Spacing="16" Padding="40,4,0,4">
                                <Grid ColumnSpacing="24" RowSpacing="16">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                    <TextBox x:Uid="AssociationExtensionsBox" Text="{x:Bind ExtensionsText, Mode=TwoWay}" IsSpellCheckEnabled="False" />
                                    <TextBox x:Uid="AssociationProgIdBox" Grid.Column="1" Text="{x:Bind ProgId, Mode=TwoWay}" IsSpellCheckEnabled="False" />
                                    <TextBox x:Uid="AssociationDescriptionBox" Grid.Row="1" Text="{x:Bind Description, Mode=TwoWay}" />
                                    <TextBox x:Uid="AssociationContentTypeBox" Grid.Row="1" Grid.Column="1" Text="{x:Bind ContentType, Mode=TwoWay}" IsSpellCheckEnabled="False" />
                                    <local:ProgramBox x:Uid="AssociationTargetCombo" Grid.Row="2" Choices="{x:Bind ExecutableChoices}" Text="{x:Bind Target, Mode=TwoWay}" VerticalAlignment="Top" />
                                    <TextBox x:Uid="AssociationArgumentsBox" Grid.Row="2" Grid.Column="1" Text="{x:Bind ArgumentsText, Mode=TwoWay}" MinHeight="64" Style="{StaticResource LinesBoxStyle}" />
                                    <Grid Grid.Row="3" ColumnSpacing="16">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <local:ProgramBox x:Uid="AssociationIconCombo" Choices="{x:Bind IconChoices}" Text="{x:Bind Icon, Mode=TwoWay}" />
                                        <NumberBox x:Uid="IconIndexBox" Grid.Column="1" Value="{x:Bind IconIndex, Mode=TwoWay}" Minimum="-65535" Maximum="65535"
                                                   SpinButtonPlacementMode="Compact" MinWidth="120" />
                                    </Grid>
                                    <ComboBox x:Uid="IfOptionCombo" Grid.Row="3" Grid.Column="1" HorizontalAlignment="Stretch"
                                              ItemsSource="{x:Bind IfOptionChoices}" SelectedItem="{x:Bind IfOptionItem, Mode=TwoWay}" />
                                </Grid>
                                <TextBlock Text="{x:Bind Error, Mode=OneWay}" Style="{StaticResource FieldErrorStyle}" Visibility="{x:Bind local:Converters.VisibleIfText(Error), Mode=OneWay}" />
                            </StackPanel>
                        </Expander>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="{x:Bind VM.Errors.Associations, Mode=OneWay}" Style="{StaticResource FieldErrorStyle}" Visibility="{x:Bind local:Converters.VisibleIfText(VM.Errors.Associations), Mode=OneWay}" />

            <!-- URL schemes -->
            <Grid Margin="0,28,0,8">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center" Margin="1,0,16,0">
                    <TextBlock x:Uid="ProtocolsSection" Style="{StaticResource BodyStrongTextBlockStyle}" AutomationProperties.HeadingLevel="Level2" />
                    <TextBlock x:Uid="ProtocolsSectionDescription" Style="{StaticResource RowDescriptionStyle}" />
                </StackPanel>
                <Button Grid.Column="1" Command="{x:Bind VM.AddProtocolCommand}" VerticalAlignment="Bottom">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE710;" FontSize="14" />
                        <TextBlock x:Uid="ProtocolsAdd" />
                    </StackPanel>
                </Button>
            </Grid>
            <Border Style="{StaticResource RowCardStyle}" Visibility="{x:Bind VM.HasNoProtocols, Mode=OneWay}">
                <TextBlock x:Uid="ProtocolsEmpty" Style="{StaticResource RowDescriptionStyle}" VerticalAlignment="Center" />
            </Border>
            <ItemsControl ItemsSource="{x:Bind VM.ProtocolRows}" IsTabStop="False">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><StackPanel Spacing="4" /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:ProtocolRow">
                        <Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" IsExpanded="{x:Bind IsExpanded, Mode=TwoWay}">
                            <Expander.Header>
                                <Grid ColumnSpacing="16" Padding="0,12">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <FontIcon Glyph="&#xE774;" Style="{StaticResource RowIconStyle}" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind Title, Mode=OneWay}" Style="{StaticResource RowTitleStyle}" />
                                        <TextBlock Text="{x:Bind Subtitle, Mode=OneWay}" Style="{StaticResource RowDescriptionStyle}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                                        <Button x:Uid="RowMoveUp" Command="{x:Bind MoveUpCommand}" Background="Transparent" BorderThickness="0" Padding="8">
                                            <FontIcon Glyph="&#xE70E;" FontSize="14" />
                                        </Button>
                                        <Button x:Uid="RowMoveDown" Command="{x:Bind MoveDownCommand}" Background="Transparent" BorderThickness="0" Padding="8">
                                            <FontIcon Glyph="&#xE70D;" FontSize="14" />
                                        </Button>
                                        <Button x:Uid="RowRemove" Command="{x:Bind RemoveCommand}" Background="Transparent" BorderThickness="0" Padding="8">
                                            <FontIcon Glyph="&#xE74D;" FontSize="14" />
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Expander.Header>
                            <StackPanel Spacing="16" Padding="40,4,0,4">
                                <Grid ColumnSpacing="24" RowSpacing="16">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                    <TextBox x:Uid="ProtocolSchemeBox" Text="{x:Bind Scheme, Mode=TwoWay}" IsSpellCheckEnabled="False" />
                                    <TextBox x:Uid="ProtocolDescriptionBox" Grid.Column="1" Text="{x:Bind Description, Mode=TwoWay}" />
                                    <local:ProgramBox x:Uid="ProtocolTargetCombo" Grid.Row="1" Choices="{x:Bind ExecutableChoices}" Text="{x:Bind Target, Mode=TwoWay}" VerticalAlignment="Top" />
                                    <TextBox x:Uid="ProtocolArgumentsBox" Grid.Row="1" Grid.Column="1" Text="{x:Bind ArgumentsText, Mode=TwoWay}" MinHeight="64" Style="{StaticResource LinesBoxStyle}" />
                                    <Grid Grid.Row="2" ColumnSpacing="16">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <local:ProgramBox x:Uid="ProtocolIconCombo" Choices="{x:Bind IconChoices}" Text="{x:Bind Icon, Mode=TwoWay}" />
                                        <NumberBox x:Uid="IconIndexBox" Grid.Column="1" Value="{x:Bind IconIndex, Mode=TwoWay}" Minimum="-65535" Maximum="65535"
                                                   SpinButtonPlacementMode="Compact" MinWidth="120" />
                                    </Grid>
                                    <ComboBox x:Uid="IfOptionCombo" Grid.Row="2" Grid.Column="1" HorizontalAlignment="Stretch"
                                              ItemsSource="{x:Bind IfOptionChoices}" SelectedItem="{x:Bind IfOptionItem, Mode=TwoWay}" />
                                </Grid>
                                <TextBlock Text="{x:Bind Error, Mode=OneWay}" Style="{StaticResource FieldErrorStyle}" Visibility="{x:Bind local:Converters.VisibleIfText(Error), Mode=OneWay}" />
                            </StackPanel>
                        </Expander>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="{x:Bind VM.Errors.Protocols, Mode=OneWay}" Style="{StaticResource FieldErrorStyle}" Visibility="{x:Bind local:Converters.VisibleIfText(VM.Errors.Protocols), Mode=OneWay}" />

            <TextBlock x:Uid="PlaceholdersHelp" Style="{StaticResource RowDescriptionStyle}" Margin="1,28,0,0" IsTextSelectionEnabled="True" />
        </StackPanel>
    </ScrollViewer>
</Page>
