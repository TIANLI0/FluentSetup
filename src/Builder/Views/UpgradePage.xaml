<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="FluentSetup.Builder.Views.UpgradePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:FluentSetup.Builder.Views"
    Background="Transparent">
    <ScrollViewer>
        <StackPanel MaxWidth="{StaticResource PageMaxWidth}" Padding="{StaticResource PagePadding}">
            <TextBlock x:Uid="UpgradePageTitle" Style="{StaticResource PageTitleStyle}" AutomationProperties.HeadingLevel="Level1" />
            <TextBlock x:Uid="UpgradePageDescription" Style="{StaticResource PageDescriptionStyle}" />

            <TextBlock x:Uid="UpgradeSection" Style="{StaticResource SectionHeaderStyle}" />
            <StackPanel Spacing="4">
                <Border Style="{StaticResource RowCardStyle}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE895;" Style="{StaticResource RowIconStyle}" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock x:Uid="UpgradeHowTitle" Style="{StaticResource RowTitleStyle}" />
                            <TextBlock x:Uid="UpgradeHowDescription" Style="{StaticResource RowDescriptionStyle}" />
                        </StackPanel>
                    </Grid>
                </Border>
                <Border Style="{StaticResource RowCardStyle}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE72B;" Style="{StaticResource RowIconStyle}" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock x:Uid="UpgradeDowngradeTitle" Style="{StaticResource RowTitleStyle}" />
                            <TextBlock x:Uid="UpgradeDowngradeDescription" Style="{StaticResource RowDescriptionStyle}" />
                        </StackPanel>
                        <ToggleSwitch Grid.Column="2" IsOn="{x:Bind VM.AllowDowngrade, Mode=TwoWay}" MinWidth="0" VerticalAlignment="Center" x:Uid="UpgradeDowngradeToggle" />
                    </Grid>
                </Border>
            </StackPanel>

            <!-- Installations made by another installer or under an older name -->
            <TextBlock x:Uid="UpgradeLegacySection" Style="{StaticResource SectionHeaderStyle}" />
            <StackPanel Spacing="4">
                <Border Style="{StaticResource RowCardStyle}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE8AB;" Style="{StaticResource RowIconStyle}" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock x:Uid="UpgradeAdoptTitle" Style="{StaticResource RowTitleStyle}" />
                            <TextBlock x:Uid="UpgradeAdoptDescription" Style="{StaticResource RowDescriptionStyle}" />
                        </StackPanel>
                        <ToggleSwitch Grid.Column="2" IsOn="{x:Bind VM.AdoptExistingInstall, Mode=TwoWay}" MinWidth="0" VerticalAlignment="Center" x:Uid="UpgradeAdoptToggle" />
                    </Grid>
                </Border>
                <Border Style="{StaticResource RowCardStyle}" Padding="20,16,20,20">
                    <StackPanel Spacing="12">
                        <TextBlock x:Uid="UpgradeLegacyKeysDescription" Style="{StaticResource RowDescriptionStyle}" />
                        <TextBox x:Uid="UpgradeLegacyKeysBox" Text="{x:Bind VM.LegacyUninstallKeysText, Mode=TwoWay}" MinHeight="72" Style="{StaticResource LinesBoxStyle}" />
                        <TextBlock Text="{x:Bind VM.Errors.InstallLegacy, Mode=OneWay}" Style="{StaticResource FieldErrorStyle}" Visibility="{x:Bind local:Converters.VisibleIfText(VM.Errors.InstallLegacy), Mode=OneWay}" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- A running copy of the app -->
            <TextBlock x:Uid="UpgradeRunningSection" Style="{StaticResource SectionHeaderStyle}" />
            <Border Style="{StaticResource RowCardStyle}" Padding="20,16,20,20">
                <StackPanel Spacing="16">
                    <TextBox x:Uid="UpgradeCloseProcessesBox" Text="{x:Bind VM.CloseProcessesText, Mode=TwoWay}" MinHeight="72" Style="{StaticResource LinesBoxStyle}" />
                    <StackPanel Spacing="8">
                        <ToggleSwitch x:Uid="UpgradeCloseCommandToggle" IsOn="{x:Bind VM.HasCloseCommand, Mode=TwoWay}" />
                        <Grid ColumnSpacing="24" Visibility="{x:Bind VM.HasCloseCommand, Mode=OneWay}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <local:ProgramBox x:Uid="UpgradeCloseRunCombo" VerticalAlignment="Top" Choices="{x:Bind VM.ExecutableChoices}" Text="{x:Bind VM.CloseCommandRun, Mode=TwoWay}" />
                            <TextBox x:Uid="UpgradeCloseArgsBox" Grid.Column="1" Text="{x:Bind VM.CloseCommandArgumentsText, Mode=TwoWay}"
                                     MinHeight="64" Style="{StaticResource LinesBoxStyle}" />
                        </Grid>
                    </StackPanel>
                    <TextBox x:Uid="UpgradeRelaunchBox" Text="{x:Bind VM.RelaunchArgumentsText, Mode=TwoWay}" MinHeight="64" Style="{StaticResource LinesBoxStyle}" />
                    <TextBlock Text="{x:Bind VM.Errors.InstallRunning, Mode=OneWay}" Style="{StaticResource FieldErrorStyle}" Visibility="{x:Bind local:Converters.VisibleIfText(VM.Errors.InstallRunning), Mode=OneWay}" />
                </StackPanel>
            </Border>

            <!-- Leftovers of earlier versions -->
            <TextBlock x:Uid="UpgradeCleanupSection" Style="{StaticResource SectionHeaderStyle}" />
            <Border Style="{StaticResource RowCardStyle}" Padding="20,16,20,20">
                <StackPanel Spacing="16">
                    <TextBlock x:Uid="UpgradeCleanupDescription" Style="{StaticResource RowDescriptionStyle}" />
                    <Grid ColumnSpacing="24" RowSpacing="16">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <TextBox x:Uid="CleanupTasksBox" Text="{x:Bind VM.CleanupScheduledTasksText, Mode=TwoWay}" MinHeight="72" Style="{StaticResource LinesBoxStyle}" />
                        <TextBox x:Uid="CleanupRunValuesBox" Grid.Column="1" Text="{x:Bind VM.CleanupRunValuesText, Mode=TwoWay}" MinHeight="72" Style="{StaticResource LinesBoxStyle}" />
                        <TextBox x:Uid="CleanupShortcutsBox" Grid.Row="1" Text="{x:Bind VM.CleanupShortcutsText, Mode=TwoWay}" MinHeight="72" Style="{StaticResource LinesBoxStyle}" />
                        <TextBox x:Uid="CleanupUninstallKeysBox" Grid.Row="1" Grid.Column="1" Text="{x:Bind VM.CleanupUninstallKeysText, Mode=TwoWay}" MinHeight="72" Style="{StaticResource LinesBoxStyle}" />
                        <TextBox x:Uid="CleanupFilesBox" Grid.Row="2" Text="{x:Bind VM.CleanupFilesText, Mode=TwoWay}" MinHeight="72" Style="{StaticResource LinesBoxStyle}" />
                    </Grid>
                    <TextBlock Text="{x:Bind VM.Errors.InstallCleanup, Mode=OneWay}" Style="{StaticResource FieldErrorStyle}" Visibility="{x:Bind local:Converters.VisibleIfText(VM.Errors.InstallCleanup), Mode=OneWay}" />
                </StackPanel>
            </Border>

            <TextBlock x:Uid="UpgradeDataSection" Style="{StaticResource SectionHeaderStyle}" />
            <Border Style="{StaticResource RowCardStyle}" Padding="20,16,20,20">
                <StackPanel Spacing="12">
                    <TextBlock x:Uid="UpgradePreserveDescription" Style="{StaticResource RowDescriptionStyle}" />
                    <TextBox x:Uid="UpgradePreserveBox" Text="{x:Bind VM.PreserveText, Mode=TwoWay}" MinHeight="96" Style="{StaticResource LinesBoxStyle}" />
                </StackPanel>
            </Border>

            <!-- Built-in updates: the installed uninstall.exe finds, verifies and runs a newer Setup.exe -->
            <TextBlock x:Uid="UpdateSection" Style="{StaticResource SectionHeaderStyle}" />
            <StackPanel Spacing="4">
                <Border Style="{StaticResource RowCardStyle}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE777;" Style="{StaticResource RowIconStyle}" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock x:Uid="UpdateSourceTitle" Style="{StaticResource RowTitleStyle}" />
                            <TextBlock x:Uid="UpdateSourceDescription" Style="{StaticResource RowDescriptionStyle}" />
                        </StackPanel>
                        <ComboBox Grid.Column="2" Style="{StaticResource RowComboStyle}" SelectedIndex="{x:Bind VM.UpdateSourceIndex, Mode=TwoWay}" x:Uid="UpdateSourceCombo">
                            <ComboBoxItem x:Uid="UpdateSourceNone" />
                            <ComboBoxItem x:Uid="UpdateSourceGitHub" />
                            <ComboBoxItem x:Uid="UpdateSourceFeed" />
                        </ComboBox>
                    </Grid>
                </Border>
                <Border Style="{StaticResource RowCardStyle}" Padding="20,16,20,20" Visibility="{x:Bind VM.UpdateIsOn, Mode=OneWay}">
                    <StackPanel Spacing="12">
                        <Grid ColumnSpacing="12" RowSpacing="12" Visibility="{x:Bind VM.UpdateIsGitHub, Mode=OneWay}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <TextBox x:Uid="UpdateGitHubBox" Text="{x:Bind VM.UpdateGitHub, Mode=TwoWay}" />
                            <TextBox x:Uid="UpdateAssetBox" Grid.Column="1" Text="{x:Bind VM.UpdateAsset, Mode=TwoWay}" />
                            <TextBox x:Uid="UpdateChecksumsBox" Grid.Row="1" Text="{x:Bind VM.UpdateChecksums, Mode=TwoWay}" />
                            <ToggleSwitch x:Uid="UpdatePrereleaseToggle" Grid.Row="1" Grid.Column="1" IsOn="{x:Bind VM.UpdatePrerelease, Mode=TwoWay}" />
                        </Grid>
                        <TextBox x:Uid="UpdateFeedBox" Text="{x:Bind VM.UpdateFeed, Mode=TwoWay}" Visibility="{x:Bind VM.UpdateIsFeed, Mode=OneWay}" />
                        <TextBox x:Uid="UpdateSignerBox" Text="{x:Bind VM.UpdateSigner, Mode=TwoWay}" />
                        <TextBlock x:Uid="UpdateHowToUse" Style="{StaticResource RowDescriptionStyle}" IsTextSelectionEnabled="True" />
                        <TextBlock Text="{x:Bind VM.Errors.Update, Mode=OneWay}" Style="{StaticResource FieldErrorStyle}" Visibility="{x:Bind local:Converters.VisibleIfText(VM.Errors.Update), Mode=OneWay}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
