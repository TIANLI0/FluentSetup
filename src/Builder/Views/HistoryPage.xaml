<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="FluentSetup.Builder.Views.HistoryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:FluentSetup.Builder.ViewModels"
    Background="Transparent">
    <ScrollViewer>
        <StackPanel MaxWidth="{StaticResource PageMaxWidth}" Padding="{StaticResource PagePadding}">
            <TextBlock x:Uid="HistoryPageTitle" Style="{StaticResource PageTitleStyle}" AutomationProperties.HeadingLevel="Level1" />
            <TextBlock x:Uid="HistoryPageDescription" Style="{StaticResource PageDescriptionStyle}" />

            <Border Style="{StaticResource RowCardStyle}" Margin="0,16,0,0" Visibility="{x:Bind VM.HasNoHistory, Mode=OneWay}">
                <StackPanel Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                    <FontIcon Glyph="&#xE81C;" Style="{StaticResource RowIconStyle}" />
                    <TextBlock x:Uid="HistoryEmpty" Style="{StaticResource RowTitleStyle}" VerticalAlignment="Center" />
                </StackPanel>
            </Border>

            <ItemsRepeater ItemsSource="{x:Bind VM.History}" Margin="0,16,0,0">
                <ItemsRepeater.Layout><StackLayout Spacing="4" /></ItemsRepeater.Layout>
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="vm:HistoryRow">
                        <Border Style="{StaticResource RowCardStyle}">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Glyph="{x:Bind Glyph}" Style="{StaticResource RowIconStyle}" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource RowTitleStyle}">
                                        <Run Text="{x:Bind Version}" /><Run Text="  ·  " /><Run Text="{x:Bind Result}" /><Run Text="  ·  " /><Run Text="{x:Bind When}" />
                                    </TextBlock>
                                    <TextBlock Text="{x:Bind Detail}" Style="{StaticResource RowDescriptionStyle}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                                               ToolTipService.ToolTip="{x:Bind Detail}" />
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="{x:Bind Size}" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <Button Click="OnInspect" Tag="{x:Bind}" IsEnabled="{x:Bind HasOutput}" x:Uid="HistoryInspect" />
                                    <Button Click="OnOpenFolder" Tag="{x:Bind}" IsEnabled="{x:Bind HasOutput}" x:Uid="HistoryOpenFolder">
                                        <FontIcon Glyph="&#xE838;" FontSize="14" />
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>
        </StackPanel>
    </ScrollViewer>
</Page>
